# Copie para .env e ajuste. Nunca commite o .env.
# Valores abaixo sao apenas para desenvolvimento local com docker-compose.yml.

NODE_ENV=development

# PostgreSQL (docker compose up -d)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/marquei

# Redis (filas BullMQ)
REDIS_URL=redis://localhost:6379

# API
API_PORT=3000

# Senha dos usuarios criados por `pnpm db:seed` (somente desenvolvimento local).
SEED_SENHA=troque-esta-senha-local

# Segredos de assinatura dos JWT (>= 32 caracteres, DISTINTOS entre si). Gere com: openssl rand -base64 48
# Console do estabelecimento (audiencia console-estabelecimento)
JWT_SEGREDO_ESTABELECIMENTO=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres
# Console da plataforma (audiencia console-plataforma); nunca reutilize o segredo acima
JWT_SEGREDO_PLATAFORMA=troque-por-outro-segredo-aleatorio-de-pelo-menos-32-caracteres
