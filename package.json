{
  "name": "marquei",
  "version": "0.0.0",
  "private": true,
  "description": "Plataforma SaaS multi-estabelecimento de agendamento por hora marcada.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gerar:api-client": "pnpm --filter @marquei/api-client gerar",
    "db:migrate": "pnpm --filter @marquei/api db:migrate",
    "db:migrate:create": "pnpm --filter @marquei/api db:migrate:create --",
    "db:seed": "pnpm --filter @marquei/api db:seed",
    "db:reset": "pnpm --filter @marquei/api db:reset",
    "mock:api": "pnpm --filter @marquei/api-client mock"
  },
  "devDependencies": {
    "@marquei/config": "workspace:*",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
